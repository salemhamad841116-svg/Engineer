{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "eslint src/ server.ts --max-warnings 0 && tsc --noEmit",
    "lint:fix": "eslint src/ server.ts --fix",
    "test:workspace-routing": "node server_backend/tests/workspaceProviderRouting.integration.test.js",
    "test:e2e": "env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY NO_PROXY='*' playwright test",
    "test:e2e:report": "playwright show-report",
    "typecheck:strict": "tsc --noEmit",
    "test:docker:live": "node scripts/verify-docker-live.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "prepare": "node -e \"try { import('node:fs').then(f => f.existsSync('scripts/setup-git-hooks.mjs') && import('./scripts/setup-git-hooks.mjs')).catch(()=>{}); } catch {}\""
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sqlite3": "^6.0.1",
    "vite": "^8.3.0",
    "node-html-parser": "^9.0.7",
    "playwright-core": "^1.65.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.47.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.1"
  }
}