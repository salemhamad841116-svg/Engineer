# ==============================================================================
# بيئة التشغيل والاختبار لمنصة المهندس الذكي (Environment Configuration Template)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. إعدادات الخادم والشبكة (Server & Network)
# ------------------------------------------------------------------------------
# في وضع التطوير المحلي: development (المنفذ الافتراضي 3000)
# في وضع الإنتاج: production (المنفذ الافتراضي 3001)
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# مفتاح تشفير الجلسات (يمكن تركه كقيمة افتراضية في بيئة الفحص المحلي)
SESSION_SECRET=local_testing_secret_key_32_characters_long_min_2026

# ------------------------------------------------------------------------------
# 2. مسارات حفظ البيانات وقاعدة البيانات المحلية SQLite
# ------------------------------------------------------------------------------
DATA_DIR=./data
DB_PATH=./data/app.db
MEDIA_STORAGE_DIR=./data/media
VIDEO_WORK_DIR=./data/video_work
ANIM_WORK_DIR=./data/anim_work

# ------------------------------------------------------------------------------
# 3. حساب المدير الرئيسي الأولي (Super Administrator)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@cloudstudio.dev
ADMIN_INITIAL_PASSWORD=Admin@Secure2026!
ADMIN_NAME=Platform Administrator
# مفتاح المصادقة الثنائية الافتراضي (يمكن تجاوزه برمز الاسترداد: REC-1111-AAAA)
ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
ADMIN_HOST=

# ------------------------------------------------------------------------------
# 4. وضع الاختبار والمحاكاة (Mock Mode - تشغيل معزول بدون أي مفاتيح خارجية)
# ------------------------------------------------------------------------------
# عند تفعيل الخيارين التاليين: سيعمل محاكي الذكاء الاصطناعي الداخلي دون الحاجة لأي مفتاح
# LLM_PROVIDER=mock
# E2E_TEST_MODE=1

# ------------------------------------------------------------------------------
# 5. مزودات نماذج الذكاء الاصطناعي (AI Provider Configuration)
# ------------------------------------------------------------------------------
# الخيارات المتاحة: gemini | openai | ollama | vllm | mock
LLM_PROVIDER=gemini

# في حال استخدام Google Gemini:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# في حال استخدام OpenAI أو نقطة نهاية متوافقة:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# في حال استخدام خادم استدلال محلي (Ollama) بدون أي تكاليف خارجية:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_MODEL_QUICK=llama3.2:3b
# LLM_MODEL_DEEP=qwen2.5:7b
# LLM_MODEL_EXPERT=deepseek-r1:7b

# ------------------------------------------------------------------------------
# 6. خدمة التحليل الثنائي وتفكيك الشفرات (Binary Analysis Engine - اختياري)
# ------------------------------------------------------------------------------
ANALYSIS_SERVICE_URL=http://127.0.0.1:8090
ANALYSIS_MAX_UPLOAD_MB=50

# ------------------------------------------------------------------------------
# 7. استوديو الوسائط والفيديو والرسوم المتحركة (Media, Video & Manim - اختياري)
# ------------------------------------------------------------------------------
# لإنتاج الرسوم المتحركة عبر Manim داخل بيئة Docker:
# MANIM_DOCKER_IMAGE=manim-render:latest
# لإنتاج الفيديو وتركيب الصوت:
# VIDEO_DOCKER_IMAGE=video-render:latest
# لتوليد الصور عبر واجهة متوافقة مع OpenAI:
# MEDIA_IMAGE_BASE_URL=https://api.openai.com/v1
# MEDIA_IMAGE_API_KEY=
# MEDIA_IMAGE_MODEL=dall-e-3
# لتحويل النصوص إلى صوت TTS:
# MEDIA_TTS_BASE_URL=https://api.openai.com/v1
# MEDIA_TTS_API_KEY=
# MEDIA_TTS_MODEL=tts-1
# MEDIA_TTS_VOICE=alloy

# ------------------------------------------------------------------------------
# 8. نظام الاشتراكات وبوابة الدفع Stripe (الإمارات - Stripe UAE - اختياري)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_mock_secret_key_uae
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret_uae
STRIPE_DEFAULT_CURRENCY=aed
STRIPE_TAX_AUTOMATIC=true
