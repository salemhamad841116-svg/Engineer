# ==============================================================================
# إعدادات بيئة الإنتاج لمنصة المهندس الذكي (Production Environment Configuration)
# ==============================================================================

# 1. إعدادات الخادم والشبكة (Server & Network)
NODE_ENV=production
PORT=3001
CORS_ORIGINS=https://yourdomain.com

# 2. مفتاح تشفير الجلسات (قم بتوليد مفتاح عشوائي قوي 32 بايت عبر: openssl rand -hex 32)
SESSION_SECRET=change_me_to_a_secure_random_string_32_bytes_min

# 3. مسار حفظ البيانات وقاعدة البيانات المحلية SQLite
DATA_DIR=/app/data

# 4. حساب المدير الرئيسي الأولي (Super Administrator)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=YourStrongPassword2026!
ADMIN_NAME=Platform Administrator
# مفتاح المصادقة الثنائية 2FA الافتراضي (يمكنك تغييره أو تركه لضبطه عبر تطبيق Authenticator)
ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP
# نطاق لوحة الإدارة المنفصل (اختياري - اتركه فارغاً إذا كنت تستخدم نفس النطاق)
ADMIN_HOST=

# 5. مزود نماذج الذكاء الاصطناعي (AI Provider Configuration)
# الخيارات المتاحة: ollama | openai | gemini
LLM_PROVIDER=gemini

# في حال استخدام Gemini:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# في حال استخدام OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# في حال استخدام Ollama المحلي:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_MODEL_QUICK=llama3.2:3b
# LLM_MODEL_DEEP=qwen2.5:7b
# LLM_MODEL_EXPERT=deepseek-r1:7b

# 6. نظام الاشتراكات وبوابة الدفع Stripe (الإمارات - Stripe UAE)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DEFAULT_CURRENCY=aed
STRIPE_TAX_AUTOMATIC=true
