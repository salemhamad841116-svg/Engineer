{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "strict": false /* Preserved as false until Phase 4 (Days 7-8) */,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "server.ts"],
  "exclude": ["dist", "_backup_soug_alhujun", "scripts", "node_modules"]
}
